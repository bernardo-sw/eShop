@model LoginViewModel

@{
    ViewData["Title"] = "Register";
}

<form asp-controller="Account" asp-action="Register" method="post">
    <img class="mb-4" src="~/images/brand/eShop-logo.png" alt="" width="72" height="57">
    <h1 class="h3 mb-3 fw-normal">Create a new account</h1>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-floating">
        <span asp-validation-for="UserName" class="text-danger"></span>
        <input asp-for="UserName" autocomplete="username" class="form-control" id="floatingUsername" placeholder="Username">
        <label for="floatingUsername">Username</label>
    </div>
    <div class="form-floating">
        <span asp-validation-for="Password" class="text-danger"></span>
        <input asp-for="Password" class="form-control" id="floatingPassword" placeholder="Password">
        <label for="floatingPassword">Password</label>
    </div>

    <button class="w-100 btn btn-lg btn-primary" type="submit">Register</button>

    <div class="mt-3">
        <a asp-controller="Account" asp-action="Login">Do you already have an account?</a>
    </div>
    <p class="mt-5 mb-3 text-muted">&copy; 2025–@DateTime.Now.Year</p>
</form>
