@model LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<form asp-controller="Account" asp-action="Login" method="post" role="form">
    <input type="hidden" asp-for="ReturnUrl" />

    <img class="mb-4" src="~/images/brand/eShop-logo.png" alt="" width="72" height="57">

    <h1 class="h3 mb-3 fw-normal">Please sign in</h1>

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-floating">
        <span asp-validation-for="UserName" class="text-danger"></span>
        <input asp-for="UserName" autocomplete="username" class="form-control" id="floatingUsername" placeholder="Username">
        <label for="floatingUsername">Username</label>
    </div>
    <div class="form-floating">
        <span asp-validation-for="Password" class="text-danger"></span>
        <input asp-for="Password" class="form-control" id="floatingPassword" placeholder="Password">
        <label for="floatingPassword">Password</label>
    </div>

    <button class="w-100 btn btn-lg btn-primary" type="submit">Sign in</button>
    <div class="mt-3">
        <a href="#">Forgot your password?</a>
    </div>

    <hr />

    <a asp-action="Register" class="w-80 btn btn-lg btn-success" role="button">Create new account</a>

    <p class="mt-5 mb-3 text-muted">&copy; 2025–@DateTime.Now.Year</p>
</form>